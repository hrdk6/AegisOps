# AegisOps configuration reference. scripts/devctl.py reads model keys and AEGIS_LLM_ROUTES from .env;
# copy other values to .env only for running a component outside
# Kubernetes (e.g. `uvicorn` against a port-forwarded database). In the kind environment,
# scripts/devctl.py generates every secret into .aegis-dev/ (git-ignored) and Kubernetes Secrets.
# Never commit real values.

# --- Model providers (all optional) -------------------------------------------------------
# Without any key, diagnosis and planning run on the deterministic rule engine only.
# devctl.py copies whichever of these are set in .env or your shell into the aegis-llm Secret.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OLLAMA_BASE_URL=            # e.g. http://host.docker.internal:11434
# Route table per purpose; entries are tried in order, "heuristic" = deterministic fallback.
# AEGIS_LLM_ROUTES={"diagnosis":["openai:gpt-4.1-mini","groq:llama-3.3-70b-versatile","heuristic"],"planning":["openai:gpt-4.1-mini","heuristic"],"postmortem":["openai:gpt-4.1-mini","heuristic"]}
AEGIS_LLM_ROUTES=
AEGIS_LLM_TIMEOUT_SECONDS=30
AEGIS_LLM_MAX_RETRIES=1
AEGIS_LLM_MAX_CALLS_PER_INCIDENT=8
# USD per 1M tokens [input, output] for cost tracking, e.g. {"gpt-4.1-mini":[0.4,1.6]}
AEGIS_LLM_PRICES=

# --- Database ----------------------------------------------------------------------------
AEGIS_DB_HOST=localhost
AEGIS_DB_PORT=5432
AEGIS_DB_USER=aegis
AEGIS_DB_PASSWORD=
AEGIS_DB_NAME=aegis

# --- API security (required by aegis-api; >= 32 characters each) --------------------------
AEGIS_JWT_SECRET=
AEGIS_APPROVAL_KEY=         # HMAC key shared with the controller (--approval-key-file)
AEGIS_JWT_TTL_MINUTES=480
# user:password:role, comma-separated; roles viewer|operator|approver|admin; passwords >= 12 chars
AEGIS_BOOTSTRAP_USERS=
AEGIS_CORS_ORIGINS=http://localhost:3000
AEGIS_RATE_LIMIT_PER_MINUTE=240
AEGIS_LOGIN_ATTEMPTS_PER_MINUTE=10

# --- Control plane and telemetry backends -----------------------------------------------
AEGIS_CONTROLPLANE_URL=http://aegis-controlplane.aegis-system.svc:8082
AEGIS_CONTROLPLANE_TOKEN_FILE=/var/run/secrets/aegis/token   # projected, audience-bound SA token
AEGIS_MANAGED_NAMESPACE=shop
AEGIS_PROMETHEUS_URL=http://prometheus.observability.svc:9090
AEGIS_LOKI_URL=http://loki.observability.svc:3100
AEGIS_JAEGER_URL=http://jaeger.observability.svc:16686
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc:4318

# --- Demo fault injection (isolated demo namespace only) --------------------------------
AEGIS_DEMO_MODE=true
AEGIS_CHAOS_URL=http://aegis-chaos.aegis-system.svc:8090
AEGIS_CHAOS_TOKEN=          # >= 24 characters

# --- Engine behaviour ----------------------------------------------------------------------
AEGIS_DETECT_INTERVAL_SECONDS=5
AEGIS_DETECTION_PERSISTENCE=2
AEGIS_INCIDENT_MERGE_WINDOW_SECONDS=600
AEGIS_ESCALATION_HOLD_SECONDS=45
AEGIS_MAX_REMEDIATION_ROUNDS=3
AEGIS_VERIFICATION_TIMEOUT_SECONDS=90
AEGIS_RECURRENCE_WATCH_SECONDS=60
AEGIS_SIMULATION_TIMEOUT_SECONDS=180
AEGIS_APPROVAL_WAIT_SECONDS=900
